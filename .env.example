# ---------------------------------------------------------------
# Select Your Destiny — environment template
# Copy to .env (never commit .env). In AWS these live in Secrets Manager.
# ---------------------------------------------------------------

# Database
DB_NAME=destiny
DB_USER=destiny
DB_PASSWORD=change-me
DB_PORT=5432

# Auth
JWT_SECRET=replace-with-a-64-char-random-string-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000
OTP_DEV_MODE=true                 # true => OTP 123456 always accepted
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Payments (MOCK | RAZORPAY | PHONEPE | PAYTM)
PAYMENT_GATEWAY=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
LAZYPAY_ACCESS_KEY=

# Notifications
FIREBASE_CREDENTIALS_JSON=        # base64 of the service-account JSON
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
SMS_PROVIDER_API_KEY=

# Web / Mobile
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api   # Android emulator -> host
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
